{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "new-relic",
  "version": "0.2.0",
  "description": "Use New Relic directly in GitHub Copilot through the hosted New Relic MCP server. Query telemetry with NRQL, investigate errors, alerts, and deployments, and explore logs, traces, and dashboards in natural language.",
  "author": {
    "name": "New Relic",
    "url": "https://newrelic.com"
  },
  "homepage": "https://docs.newrelic.com/docs/agentic-ai/mcp/overview/",
  "repository": "https://github.com/newrelic-partners/Github-Copilot-plugin",
  "license": "Apache-2.0",
  "keywords": [
    "new-relic",
    "observability",
    "monitoring",
    "apm",
    "nrql",
    "logs",
    "traces",
    "alerts",
    "incidents",
    "kubernetes",
    "finops",
    "mcp"
  ],
  "extensions": {
    "com.github.awesome-copilot": {
      "skills": [
        "./skills/nrsetup/",
        "./skills/nrql/",
        "./skills/nrinvestigate/"
      ]
    }
  }
}
